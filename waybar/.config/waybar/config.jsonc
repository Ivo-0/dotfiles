{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 6,

    "modules-left": ["idle_inhibitor", "custom/theme-toggle", "custom/updates", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right": ["backlight", "custom/power-profile", "cpu", "pulseaudio", "network", "bluetooth", "tray", "custom/powermenu"],

    "hyprland/workspaces": {
        "format": "{id}"
    },

    "hyprland/window": {
        "format": "{}"
    },

"clock": {
    "format": "{:%H:%M  %a-%d-%b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "today-format": "<b>{}</b>",
    "on-click": "~/.config/waybar/scripts/toggle-calendar.sh",
    "on-click-right": "hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"calendar\"))'"
},

"custom/weather": {
  "exec": "~/.config/waybar/weather.py waybar",
  "restart-interval": 900,
  "return-type": "json"
},

"custom/theme-toggle": {
    "exec": "~/.config/hypr/scripts/theme-status.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/toggle-theme.sh",
    "tooltip": false
},

"custom/updates": {
    "exec": "~/.config/hypr/scripts/update-packages.sh",
    "interval": 3600,
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/run-update.sh",
    "tooltip": true
},

"idle_inhibitor": {
    "format": "{icon}",
    "tooltip": false,
    "format-icons": {
        "activated": " 󰈈 ACTIVE 󰈈 ",
        "deactivated": " INACTIVE "
    }
},

"custom/power-profile": {
    "exec": "~/.config/hypr/scripts/battery-info.sh",
    "interval": 5,
    "return-type": "json",
    "on-click": "~/.config/hypr/scripts/toggle-profile.sh",
    "tooltip": true
},

"cpu": {
    "format": "  {usage}%",
    "interval": 2,
    "on-click":"~/.config/waybar/scripts/toggle-btop.sh",
    "on-click-right": "hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"sysstats\"))'"
},

"backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
},

"pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 MUTED",
    "format-icons": {
        "default": [" ", " ", " "]
    },
    "on-click": "~/.config/waybar/scripts/toggle-volume.sh",
    "on-click-right": "hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"volume\"))'"
},

"network": {
    "format-wifi": "{essid}",
    "format-disconnected": "Disconnected",
    "on-click": "~/.config/waybar/scripts/toggle-network.sh",
    "on-click-right":"hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"network\"))'" 
    },

"bluetooth": {
    "format": "BT {status}",
    "format-connected": "BT {device_alias}",
    "format-disabled": "BT off",
    "on-click": "~/.config/waybar/scripts/toggle-bluetooth.sh",
    "on-click-right":"hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"bluetooth\"))'",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
},

"custom/powermenu": {
    "format": "⏻",
    "on-click": "~/.config/hypr/scripts/powermenu.sh",
    "tooltip": false
},

    "tray": {
        "spacing": 10
    }
}
